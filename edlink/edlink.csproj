<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net8.0-windows</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Edlink</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <WarningLevel>4</WarningLevel>
    <ApplicationIcon>ed.ico</ApplicationIcon>
    <AssemblyTitle>edlink</AssemblyTitle>
    <Product>edlink</Product>
    <Copyright>Copyright ©  2026</Copyright>
    <AssemblyVersion>1.0.0.1</AssemblyVersion>
    <FileVersion>1.0.0.1</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="cat.ico" />
    <Content Include="ed.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="10.0.9" Condition="$(TargetFramework.EndsWith('windows'))" />
    <PackageReference Include="System.IO.Ports" Version="10.0.9" />
  </ItemGroup>
</Project>